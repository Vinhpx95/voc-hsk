rules_version = '2';
// Voc-Lang — dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
//
// Thay EMAIL_QUAN_TRI@gmail.com bằng email Google của quản trị viên (chỉ sửa trong Console,
// không cần commit email thật lên GitHub).
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản trị viên: đăng nhập Google bằng đúng email này và email đã được Google xác minh
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'EMAIL_QUAN_TRI@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Trang báo cáo (admin-report/): admin chỉ ĐỌC hồ sơ + số liệu tổng (users/{uid}),
    // không đọc được tiến độ chi tiết từng từ và không ghi được dữ liệu của người khác.
    match /users/{uid} {
      allow read: if isAdmin();
    }

    // Mỗi người chỉ đọc/ghi được dữ liệu của chính mình (users/{uid} và mọi tài liệu con)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Đơn mua tài liệu: orders/{uid}_{productId} — mỗi tài khoản một đơn cho mỗi gói ----------
    // status: pending (chờ thanh toán) → reported (đã báo chuyển khoản) → sent (đã gửi tài liệu)
    //         unpaid (chưa thấy tiền, admin đặt) · cancelled (đã hủy: người mua bấm "Tôi chưa mua" hoặc admin hủy)
    // Đơn pending quá 7 ngày được web hiển thị là đã hủy (không cần ghi lại).
    // Người mua chỉ đổi được trạng thái theo các bước bên dưới; mọi thay đổi khác (gửi tài liệu, chưa thấy tiền,
    // hủy) do admin làm trên trang quản trị hoặc Apps Script chạy bằng tài khoản chủ dự án (không qua Rules).
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function ownsOrder(orderId) {
      return signedIn() && orderId.split('_')[0] == request.auth.uid;
    }
    function now(field) {
      return request.resource.data[field] == request.time;
    }
    // Nội dung đơn (giá, tên gói, mã chuyển khoản) — kiểm tra khi tạo mới hoặc mở lại đơn
    function validOrderBody(orderId) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.productId in ['hsk13', 'audio', 'combo']
        && orderId == request.auth.uid + '_' + d.productId
        && d.price is int && d.price > 0 && d.price < 10000000
        && d.code is string && d.code.matches('[A-Z0-9]{6}')
        && d.transfer is string && d.transfer.size() <= 50
        && d.productName is string && d.productName.size() <= 120
        && d.name is string && d.name.size() <= 100;
    }
    function buyerUpdate(orderId) {
      let from = resource.data.status;
      let to = request.resource.data.status;
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return ownsOrder(orderId) && (
        // Bấm "Đã chuyển khoản"
        ((from == 'pending' || from == 'unpaid') && to == 'reported'
          && keys.hasOnly(['status', 'updatedAt', 'reportedAt']) && now('updatedAt') && now('reportedAt'))
        // Bấm "Tôi chưa mua"
        || (from == 'pending' && to == 'cancelled'
          && keys.hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelReason'])
          && now('updatedAt') && now('cancelledAt') && request.resource.data.cancelReason == 'buyer')
        // Mở lại đơn đã hủy / đơn chờ quá hạn (tính lại giá, mã chuyển khoản theo cấu hình hiện tại)
        || ((from == 'pending' || from == 'cancelled') && to == 'pending'
          && keys.hasOnly(['status', 'updatedAt', 'createdAt', 'price', 'productName', 'code', 'transfer', 'name', 'cancelledAt', 'cancelReason'])
          && now('updatedAt') && now('createdAt') && validOrderBody(orderId))
      );
    }
    match /orders/{orderId} {
      allow get: if isAdmin() || ownsOrder(orderId);
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if ownsOrder(orderId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'productId', 'productName', 'price', 'code', 'transfer', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'productId', 'productName', 'price', 'code', 'transfer', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending' && now('createdAt') && now('updatedAt')
        && validOrderBody(orderId);
      allow update: if isAdmin() || buyerUpdate(orderId);
      allow delete: if isAdmin();
    }
  }
}
